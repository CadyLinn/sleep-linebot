{
  "displayName": "sleep-linebot: 回應變慢",
  "documentation": {
    "mimeType": "text/markdown",
    "content": "p95 延遲連續 10 分鐘超過 2 秒。LINE webhook 回覆太慢會讓使用者覺得機器人沒反應。檢查 Firestore 索引是否建好（`ops/firestore_indexes.sh`）、log 中是否有 `composite index missing`，以及冷啟動。"
  },
  "combiner": "OR",
  "conditions": [{
    "displayName": "p95 latency > 2s for 10 min",
    "conditionThreshold": {
      "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"__SERVICE__\"",
      "comparison": "COMPARISON_GT",
      "thresholdValue": 2000,
      "duration": "600s",
      "aggregations": [{"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_MAX"}]
    }
  }],
  "notificationChannels": ["__CHANNEL__"],
  "alertStrategy": {"autoClose": "86400s"}
}
